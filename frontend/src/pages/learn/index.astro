---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTutorialsByPart } from '../../lib/tutorials';

const parts = getTutorialsByPart();
---

<BaseLayout
  title="Learn — Hypergraph Portfolio Lab Textbook"
  description="Master distributed portfolio optimization, hypergraphs, Bayesian uncertainty calibration, and overlapping cohort dynamics across 42 numbered chapters."
>
  <div class="learn-header-section">
    <div class="container">
      <div class="learn-hero-badge">Research Textbook</div>
      <h1 class="learn-hero-title">Hypergraph Portfolio Lab</h1>
      <p class="learn-hero-subtitle">
        42 numbered, first-principles chapters spanning distributed consensus optimization, continuous-time primal-dual dynamics, Bayesian-LoRA uncertainty audits, and temporal regularization frontiers.
      </p>

      <div class="learn-stats-bar">
        <div class="stat-item">
          <span class="stat-val">42</span>
          <span class="stat-lbl">Chapters</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <span class="stat-val">7</span>
          <span class="stat-lbl">Parts</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <span class="stat-val">100%</span>
          <span class="stat-lbl">Open-Source TeX & Math</span>
        </div>
        <div class="stat-sep"></div>
        <div class="stat-item">
          <span class="stat-val">0</span>
          <span class="stat-lbl">Unverified Claims</span>
        </div>
      </div>

      <!-- Quick Search / Filter Input -->
      <div class="search-filter-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="tutorial-search"
          placeholder="Search 42 chapters by topic, algorithm, or chapter number (e.g. 'hypergraph', 'hysteresis', '41')..."
          aria-label="Search Chapters"
        />
      </div>
    </div>
  </div>

  <div class="container textbook-body">
    {parts.map((p) => (
      <section class="textbook-part" id={p.part.id}>
        <div class="part-header-card">
          <div class="part-tag">Part {p.part.number}</div>
          <h2 class="part-heading">{p.part.title}</h2>
          <p class="part-desc">{p.part.description}</p>
        </div>

        <div class="chapters-grid">
          {p.tutorials.map((t) => (
            <a
              href={`/learn/${t.slug}`}
              class="chapter-card card-interactive"
              data-title={t.title.toLowerCase()}
              data-number={t.number}
              data-desc={t.description.toLowerCase()}
            >
              <div class="chapter-card-top">
                <span class="chapter-badge">Ch {t.formattedNumber}</span>
                <span class="chapter-read-time">{t.readingTimeMinutes} min read</span>
              </div>
              <h3 class="chapter-card-title">{t.title}</h3>
              <p class="chapter-card-desc">{t.description}</p>
              <div class="chapter-card-footer">
                <span class="read-link">Read chapter →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .learn-header-section {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: 4.5rem 0 3.5rem;
    text-align: center;
  }

  .learn-hero-badge {
    display: inline-block;
    font-size: 0.775rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blue);
    background: var(--color-blue-tint);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .learn-hero-title {
    font-size: 3rem;
    letter-spacing: -0.035em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .learn-hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .learn-stats-bar {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding: 0.85rem 2rem;
    background: var(--bg-surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    margin-bottom: 2.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-lbl {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-sep {
    width: 1px;
    height: 24px;
    background: var(--border-subtle);
  }

  .search-filter-box {
    max-width: 640px;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .search-filter-box input {
    width: 100%;
    padding: 0.9rem 1.25rem 0.9rem 3.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-medium);
    background: var(--bg-canvas);
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .search-filter-box input:focus {
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15);
    background: var(--bg-surface);
  }

  .textbook-body {
    padding: 4rem 1.5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .textbook-part {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .part-header-card {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .part-tag {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-blue);
    margin-bottom: 0.35rem;
  }

  .part-heading {
    font-size: 1.75rem;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .part-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 800px;
    margin-bottom: 0;
  }

  .chapters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .chapter-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chapter-card:hover {
    border-color: var(--color-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .chapter-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .chapter-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    background: var(--bg-surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  .chapter-read-time {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .chapter-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.6rem;
    line-height: 1.35;
  }

  .chapter-card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .chapter-card-footer {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .read-link {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--color-blue);
  }

  @media (max-width: 640px) {
    .learn-hero-title {
      font-size: 2.25rem;
    }
    .learn-stats-bar {
      flex-direction: column;
      gap: 0.75rem;
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }
    .stat-sep {
      display: none;
    }
    .chapters-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('tutorial-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.chapter-card') as NodeListOf<HTMLElement>;
  const parts = document.querySelectorAll('.textbook-part') as NodeListOf<HTMLElement>;

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const number = card.getAttribute('data-number') || '';
        const desc = card.getAttribute('data-desc') || '';

        const matches = !q || title.includes(q) || number === q || desc.includes(q);
        card.style.display = matches ? 'flex' : 'none';
      });

      // Hide empty parts
      parts.forEach((part) => {
        let hasVisible = false;
        part.querySelectorAll('.chapter-card').forEach((c) => {
          if ((c as HTMLElement).style.display !== 'none') {
            hasVisible = true;
          }
        });
        part.style.display = hasVisible ? 'flex' : 'none';
      });
    });
  }
</script>
