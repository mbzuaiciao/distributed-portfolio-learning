---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Hypergraph Portfolio Lab">
  <div class="not-found-container">
    <div class="not-found-badge">404</div>
    <h1 class="not-found-title">Page Not Found</h1>
    <p class="not-found-desc">
      The research note, tutorial chapter, or artifact you requested could not be located in the current laboratory directory.
    </p>
    <div class="not-found-actions">
      <a href="/" class="btn btn-primary">Return to Overview</a>
      <a href="/learn" class="btn btn-secondary">Browse Textbook Chapters</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem;
  }

  .not-found-badge {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-blue);
    background: var(--color-blue-tint);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
  }

  .not-found-title {
    font-size: 2.75rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .not-found-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .not-found-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
