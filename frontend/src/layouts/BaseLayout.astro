---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hypergraph Portfolio Lab — Distributed Portfolio Optimization & Uncertainty Audits',
  description = 'A pedagogical, mathematically rigorous, and auditable research laboratory investigating distributed optimization, hypergraphs, Bayesian LoRA uncertainty, and temporal regularization.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main style="flex: 1;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
