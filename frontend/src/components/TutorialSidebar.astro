---
import { getTutorialsByPart } from '../lib/tutorials';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const parts = getTutorialsByPart();
---

<aside class="tutorial-sidebar" aria-label="Tutorial Chapters">
  <div class="sidebar-header">
    <div class="sidebar-title">Research Textbook</div>
    <div class="sidebar-subtitle">42 Numbered Chapters</div>
  </div>

  <div class="sidebar-scroll">
    {parts.map((p) => (
      <div class="sidebar-part">
        <div class="part-header">
          <span class="part-num">Part {p.part.number}</span>
          <span class="part-title">{p.part.title}</span>
        </div>
        <ul class="chapter-list">
          {p.tutorials.map((t) => {
            const isActive = t.slug === currentSlug;
            return (
              <li class="chapter-item">
                <a
                  href={`/learn/${t.slug}`}
                  class={`chapter-link ${isActive ? 'active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="chapter-badge">{t.formattedNumber}</span>
                  <span class="chapter-name">{t.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</aside>

<style>
  .tutorial-sidebar {
    width: 300px;
    flex-shrink: 0;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    height: calc(100vh - var(--nav-height));
    position: sticky;
    top: var(--nav-height);
    display: flex;
    flex-direction: column;
  }

  .sidebar-header {
    padding: 1.25rem 1.25rem 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .sidebar-subtitle {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 0.15rem;
  }

  .sidebar-scroll {
    overflow-y: auto;
    padding: 1rem 0.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-part {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .part-header {
    padding: 0 0.5rem 0.25rem;
    display: flex;
    flex-direction: column;
  }

  .part-num {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-blue);
  }

  .part-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .chapter-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .chapter-link {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.825rem;
    line-height: 1.35;
    transition: all 0.12s ease;
  }

  .chapter-link:hover {
    background: var(--bg-surface-secondary);
    color: var(--text-primary);
  }

  .chapter-link.active {
    background: var(--color-blue-tint);
    color: var(--color-blue);
    font-weight: 500;
  }

  .chapter-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .chapter-link.active .chapter-badge {
    color: var(--color-blue);
  }

  .chapter-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .tutorial-sidebar {
      display: none;
    }
  }
</style>
