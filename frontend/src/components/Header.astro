---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Overview', active: pathname === '/' },
  { href: '/learn', label: 'Learn', active: pathname.startsWith('/learn') },
  { href: '/research', label: 'Research', active: pathname.startsWith('/research') },
  { href: '/experiments', label: 'Experiments', active: pathname.startsWith('/experiments') },
];
---

<header class="nav-header">
  <div class="nav-container">
    <a href="/" class="nav-brand" aria-label="Hypergraph Portfolio Lab Home">
      <svg class="nav-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="6" cy="6" r="3"/>
        <circle cx="18" cy="6" r="3"/>
        <circle cx="12" cy="18" r="3"/>
        <line x1="8.5" y1="7.5" x2="10" y2="15.5"/>
        <line x1="15.5" y1="7.5" x2="14" y2="15.5"/>
        <line x1="9" y1="6" x2="15" y2="6"/>
      </svg>
      <span>Hypergraph Portfolio Lab</span>
    </a>

    <nav class="nav-links desktop-only" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${item.active ? 'active' : ''}`}>
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/mbzuaiciao/distributed-portfolio-learning"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link github-link"
        aria-label="GitHub Repository"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </nav>

    <button id="mobile-menu-btn" class="mobile-toggle mobile-only" aria-label="Toggle Navigation Menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden">
    <div class="mobile-menu-inner">
      {navItems.map((item) => (
        <a href={item.href} class={`mobile-nav-link ${item.active ? 'active' : ''}`}>
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/mbzuaiciao/distributed-portfolio-learning"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link"
      >
        GitHub Repository ↗
      </a>
    </div>
  </div>
</header>

<style>
  .desktop-only {
    display: flex;
  }
  .mobile-only {
    display: none;
  }

  .github-link {
    display: flex;
    align-items: center;
    color: var(--text-secondary);
  }
  .github-link:hover {
    color: var(--text-primary);
  }

  .mobile-toggle {
    color: var(--text-primary);
    padding: 0.35rem;
    border-radius: var(--radius-sm);
  }

  .mobile-menu {
    position: absolute;
    top: var(--nav-height);
    left: 0;
    right: 0;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu.hidden {
    display: none;
  }

  .mobile-menu-inner {
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav-link {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    background-color: var(--bg-surface-secondary);
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: block;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
